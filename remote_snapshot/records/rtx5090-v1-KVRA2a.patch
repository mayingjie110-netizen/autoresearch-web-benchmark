+def platform_attention(q, k, v, window_size):
+    """PyTorch SDPA adapter for equal-length causal self-attention (B, T, H, D)."""
+    left, right = window_size
+    assert left >= -1 and right == 0, "Only causal left windows are supported"
+    assert q.size(1) == k.size(1) == v.size(1), "Self-attention lengths must match"
+    seq_len = q.size(1)
+    q, k, v = (x.transpose(1, 2) for x in (q, k, v))
+    use_gqa = q.size(1) != k.size(1)
+    if left == -1 or left >= seq_len - 1:
+        out = F.scaled_dot_product_attention(
+            q, k, v, is_causal=True, dropout_p=0.0, enable_gqa=use_gqa,
+        )
+    else:
+        positions = torch.arange(seq_len, device=q.device)
+        distance = positions[:, None] - positions[None, :]
+        # FlashAttention includes both endpoints: i-left <= j <= i.
+        allowed = (distance >= 0) & (distance <= left)
+        out = F.scaled_dot_product_attention(
+            q, k, v, attn_mask=allowed, dropout_p=0.0, enable_gqa=use_gqa,
+        )
+    return out.transpose(1, 2)
+
