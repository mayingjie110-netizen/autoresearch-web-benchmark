\pgfdeclarehorizontalshading[frametitle.bg,frametitle right.bg]{beamer@frametitleshade}{\paperheight}{%
	color(0pt)=(frametitle.bg);
	color(\paperwidth)=(frametitle right.bg)}

\pgfdeclareverticalshading{beamer@topshade}{\paperwidth}{%
	color(0pt)=(bg);
	color(4pt)=(black!50!bg)
}

\defbeamertemplate*{footline}{neu theme}{%
	\leavevmode%
	\hbox{%
		% Short author name
		\begin{beamercolorbox}[wd=.15\paperwidth,ht=0.25cm,dp=1ex,center]{words in head/foot}%
			\usebeamerfont{author in head/foot} \insertshortauthor
		\end{beamercolorbox}%
		% Short institute name
		\begin{beamercolorbox}[wd=.15\paperwidth,ht=0.25cm,dp=1ex,center]{words in head/foot}%
			\usebeamerfont{author in head/foot}\insertshortinstitute
		\end{beamercolorbox}%
		% Content navigation
		\begin{beamercolorbox}[wd=.6\paperwidth,ht=0.25cm,dp=1ex,center]{words in head/foot}%
			\usebeamerfont{author in head/foot} \insertsectionnavigationhorizontal{.6\textwidth}{}{}
		\end{beamercolorbox}%
		% Page number
		\begin{beamercolorbox}[wd=0.1\paperwidth,ht=0.25cm,dp=1ex,right]{words in head/foot}%
			\centering
			\insertframenumber{} / \inserttotalframenumber\hspace{0.2cm}
		\end{beamercolorbox}
	}%
	\vskip0pt%
}
% Remove all heading
\setbeamertemplate{headline}{}

% Setup 
\defbeamertemplate*{frametitle}{neu theme}{
	% \vskip -0.5em
	\nointerlineskip
	\begin{beamercolorbox}[wd=\paperwidth, ht=1cm, dp=1pt, left, sep=.2cm]{frametitle}
		\ifnum\draft=0
			\begin{tikzpicture}[remember picture, overlay]
				\node[anchor=north west, opacity=1, inner sep=0, outer sep=0] at (current page.north west) {\pgfuseimage{bghead}};
			\end{tikzpicture}
		\fi
		\usebeamerfont{frametitle} \insertframetitle
	\end{beamercolorbox}
	\vskip 0.5em
}
\defbeamertemplate*{title page}{neu theme}{
	\leavevmode
	\hbox{
		\begin{tikzpicture}[overlay,remember picture]
			\ifnum\draft=0
				\node[opacity=1] at (current page.center){\pgfuseimage{bgtitlepage}};
			\fi
			\node[fill=main blue, rounded corners, opacity=0.7, minimum width=.8\paperwidth, minimum height=.4\paperheight, draw=main blue] at (current page.center) { ~};
			\node[minimum width=.8\paperwidth, minimum height=.4\paperheight, align=center, text width=\paperwidth] at (current page.center) {
			{\usebeamerfont{title}\inserttitle} \\
			~ \\
			{\usebeamerfont{author}\insertauthor} \\
			~ \\
			{\usebeamerfont{institute}\insertinstitute}
			};
		\end{tikzpicture}
	}
}
\newcommand{\NEUInsertTitlePage}{
	\begin{frame}[plain]
		\titlepage
		\addtocounter{framenumber}{-1}
	\end{frame}

}

\setbeamertemplate{section in toc}{%
	\leavevmode
	\leftskip=\neu@ContentLeftMargin
	\begin{tikzpicture}
		\node[name=num, text=white, fill=main blue] {\small \inserttocsectionnumber};
		\node[name=sectionname, anchor=south west, right=.2cm of num, text width=\neu@ContentItemWidth]{\Large \bfseries \inserttocsection};
		\path[draw, very thick, main blue] let \p1=(num.south west), \p2=(sectionname.north east) in ($(\x1, \y1)+(-0.2cm, -0.2cm)$) |- ($(\x2, \y2)+(0.2cm, 0.2cm)$) |- cycle;
	\end{tikzpicture}
	\par}

\newcommand{\NEUInsertContentPage}{
	\begin{frame}[plain]
		\begin{tikzpicture}[overlay, remember picture]
			\node[fill=white, minimum width=\paperwidth, minimum height=\paperheight] at (current page.center) {~};
			\node[anchor=west, inner sep=0, outer sep=0] at (current page.west) {\pgfuseimage{bgleft}};

			\ifthenelse{\equal{\neu@lang}{zh}}{%
				\node[anchor=west, inner sep=0, outer sep=0, align=center, minimum width=4cm, text=white] at (current page.west) {
					\usebeamerfont{title}\textbf{目录}};
			}{
				\node[anchor=west, inner sep=0, outer sep=0, align=center, minimum width=4cm, text=white] at (current page.west) {\usebeamerfont{title} \textbf{Content} \\ ~ \\ \usebeamerfont{title}\textbf{Table}};
			}
		\end{tikzpicture}
		\tableofcontents[hideallsubsections]
		\addtocounter{framenumber}{-1}
	\end{frame}
}

\newcommand{\NEUInsertThanksPage}[1]{
	\begin{frame}[plain]
		\begin{center}
			\begin{minipage}{1\textwidth}
				% \NEUInsertTextBox{#1}{NEURedBox}{0.80}
				\begin{beamercolorbox}[wd=0.80\textwidth, rounded=true, shadow=true]{NEURedBox}
					#1  \\
				\end{beamercolorbox}
			\end{minipage}
		\end{center}
	\end{frame}
}

