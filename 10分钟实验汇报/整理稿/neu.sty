% Font settings for items
\setbeamerfont{normal text}{size=\small}
\setbeamertemplate{itemize/enumerate body begin}{\normalsize}
\setbeamertemplate{itemize/enumerate subbody begin}{\small}

% Package parameters
% Param setting begin
\RequirePackage{ifthen}
\RequirePackage{kvoptions}
% Package Options
\SetupKeyvalOptions{
	family=neu,
	prefix=neu@
}
\DeclareStringOption[en]{lang}
\DeclareStringOption[full]{render}
\DeclareStringOption[43]{aspectratio}

\ProcessKeyvalOptions{neu}
% Param setting end

% Language-specific font settings
\ifthenelse{\equal{\neu@lang}{en}}{%
	% English language settings (default)
	\usefonttheme{default}
}{
	\ifthenelse{\equal{\neu@lang}{zh}}{
		\RequirePackage{fontspec}
		\RequirePackage{ctex}
		\setsansfont{Times New Roman}
		\setCJKsansfont[ItalicFont={楷体},BoldFont={黑体}]{宋体}
		\setbeamerfont{caption}{size=\scriptsize}
	}{
		% Invalid language option
		\PackageError{neu}{Invalid language option. Use 'en' or 'zh'}{%
			The language option must be either 'en' or 'zh'.%
		}
	}
}

\ifthenelse{\equal{\neu@render}{full}}{%
	\def\draft{0}
}{%
	\ifthenelse{\equal{\neu@render}{draft}}{%
		\def\draft{1}
	}{
		\PackageError{neu}{Invalid render option. Use 'full' or 'draft'}{
			The render option must be either 'full' or 'draft'
		}
	}
}

% Setup materials for different aspectratio
\ifthenelse{\equal{\neu@aspectratio}{169}}{
	\pgfdeclareimage[width=\paperwidth,height=\paperheight]{bgtitlepage}{source/bg-titlepage169.png}
	\pgfdeclareimage[width=\paperwidth,height=1cm]{bghead}{source/bg-head169.png}
	\pgfdeclareimage[width=4cm, height=\paperheight]{bgleft}{source/bg-left169.png}
	\def\neu@ContentLeftMargin{5cm}
	\def\neu@ContentItemWidth{6cm}
}{
	\ifthenelse{\equal{\neu@aspectratio}{43}}{
		\pgfdeclareimage[width=\paperwidth,height=\paperheight]{bgtitlepage}{source/bg-titlepage43.png}
		\pgfdeclareimage[width=\paperwidth,height=1cm]{bghead}{source/bg-head43.png}
		\pgfdeclareimage[width=4cm, height=\paperheight]{bgleft}{source/bg-left43.png}
		\def\neu@ContentLeftMargin{4cm}
		\def\neu@ContentItemWidth{5cm}
	}{
		\PackageError{neu}{Invalid aspectratio option. Use '169' or '43'}{
			The asepctratio option must be either '169' or '43'
		}
	}
}

